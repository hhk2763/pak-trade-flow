SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEAD_WEBHOOK_URL=

# AI weekly trade briefing.
#
# Works against DeepSeek directly or through an OpenAI-compatible gateway.
# Both hand out keys starting "sk-", so the base URL and model must match the
# key you are using:
#
#   Native DeepSeek  key "sk-" + 32 hex
#     DEEPSEEK_BASE_URL=https://api.deepseek.com      (the default)
#     DEEPSEEK_MODEL=deepseek-chat
#
#   OpenRouter       key "sk-or-v1-" + 64 hex
#     DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
#     DEEPSEEK_MODEL=deepseek/deepseek-chat
#
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Shared secret required by POST /api/briefing/dispatch. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIEFING_CRON_SECRET=
